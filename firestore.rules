rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // School Profile Settings & Logos for cross-device synchronization
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Lab Control Card Sessions
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId)
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 128
        && request.resource.data.items is list;
      allow delete: if isValidId(sessionId);
    }
  }
}
